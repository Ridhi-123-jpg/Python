//Binary Search
lst=[]
n=int(input("enter size of list: "))
for i in range(n):
    e=int(input("enter the element"))
    lst.append(e)
lst.sort()
print(lst)
v=int(input("enter the element to search"))
low=0
high=n-1
while(low<=high):
    mid=(low+high)//2
    if(lst[mid]==v):
        print("element found at pos",mid)
        break
    elif(v>lst[mid]):
        low=mid+1
    else:
        high=mid-1
else:
    print("element not found")
