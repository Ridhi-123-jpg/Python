//write a program to perform searching activity using linear search
lst=[]
n=int(input("enter size of list: "))
for i in range (n):
    e=int(input("enter the element"))
    lst.append(e)
print(lst)
v=int(input("enter the element to search"))
for i in lst:
    if(i==v):
        print("element found")
    else:
        print("not found")
